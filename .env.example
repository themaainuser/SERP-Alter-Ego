# Copy to .env (loaded automatically on startup) and adjust. Everything is optional.

# --- Network ---
HOST=127.0.0.1            # use 0.0.0.0 to reach the service from other machines on your LAN (there is no authentication!)
PORT=3000
# PUBLIC_BASE_URL=http://my-server:3000   # base for json_endpoint / pagination links if you run behind a proxy
# PROXY_URL=http://user:pass@host:8080    # route ALL outbound traffic (browser + every Node request) through a proxy.
                                          # The main defence against Google's IP-reputation blocks: a fresh residential
                                          # IP is challenged far less often. socks5://host:1080 also works; a bare
                                          # host:port is treated as http://. Leave unset to go direct.

# --- Scraping mode (can also be changed at runtime from the UI / PATCH /api/settings) ---
HEADLESS=false            # true: render pages in headless Chrome; false: plain HTTP requests
HEADLESS_FALLBACK=false   # retry in headless Chrome when HTTP mode is served Google's "enable JavaScript" wall
ROBOTS_POLICY=enforce     # enforce | warn | off  (Google's robots.txt disallows /search: see README)
RATE_MIN_INTERVAL_MS=2500 # minimum gap between requests to the same host
CACHE_TTL_SECONDS=300     # 0 disables the result cache

# --- Browser ---
# CHROME_PATH=/usr/bin/google-chrome   # otherwise the Chrome installed by "npm run install-browser" is used
# CHROME_USER_DATA_DIR=/home/you/.config/google-chrome   # persistent profile dir (contains Default/, Local State). Omit for isolated contexts.
# CHROME_PROFILE_NAME=Default            # leaf inside the User Data dir (Default, Profile 1, ...). Never a full path.
# CHROME_NO_SANDBOX=true               # needed when running as root / inside Docker
# BROWSER_HEADFUL=true                 # show the browser window (e.g. to solve a CAPTCHA by hand)
BROWSER_MAX_PAGES=2
BROWSER_IDLE_CLOSE_MS=300000
BROWSER_STEALTH=true               # open-source anti-detection (drops navigator.webdriver, fills window.chrome gaps) so Google challenges less often
BROWSER_HUMAN_SEARCH=true          # open google.com and type the query instead of deep-linking straight to /search
BROWSER_CAPTCHA_INTERACTIVE=true   # headful: keep a /sorry/ CAPTCHA page open until you solve it by hand, then continue
CAPTCHA_MAX_AUTO_ATTEMPTS=3        # script first tries to clear the CAPTCHA itself (re-nav + solver); after this many
                                    # failures it stops and tells you to solve it manually (0 = skip straight to you)
BROWSER_CAPTCHA_WAIT_MS=180000     # how long to wait for that hand-solve before giving up (3 min)
CAPTCHA_SOLVER=none                 # none | 2captcha — optional PAID solver for unattended runs. Off by default
                                    # (the human-in-loop above stays the default); enable by setting BOTH this
                                    # and CAPTCHA_SOLVER_API_KEY. Unknown provider names fall back to none.
# CAPTCHA_SOLVER_API_KEY=...        # your API key; nothing is contacted without it
# CAPTCHA_SOLVER_TIMEOUT_MS=60000   # how long the solver gets to return a token / for the page to leave /sorry/

# --- Defaults for requests that omit them ---
DEFAULT_HL=en
DEFAULT_GL=us
DEFAULT_GOOGLE_DOMAIN=google.com

# --- Logging / storage ---
LOG_LEVEL=info            # debug | info | warn | error | silent
LOG_FORMAT=pretty         # pretty | json
DATA_DIR=./data           # persisted runtime settings live here
# ARCHIVE_DIR=./archive   # persist every search (<id>.html + <id>.json) so /searches/<id>… links (raw_html_file,
                          # json_endpoint) survive restarts, like SerpApi's stored results. Unset = memory only.
# ARCHIVE_SIZE=25         # in-memory ring buffer of recent searches (disk keeps everything when ARCHIVE_DIR is set)
HISTORY_SIZE=100

# --- Advanced ---
# USER_AGENT=...          # browser-like UA sent upstream
# ROBOTS_USER_AGENT=SerpAlterEgo
# GOOGLE_RESOLVE_LINKS=false   # keep Google's encrypted /goto?url=... links instead of resolving them to real destinations
# RATE_JITTER_MS=500  RATE_CONCURRENCY=1  RATE_MAX_QUEUE=25  RATE_MAX_WAIT_MS=120000  BLOCK_COOLDOWN_MS=300000
# HTTP_TIMEOUT_MS=15000  HTTP_MAX_RETRIES=2  HTTP_RETRY_BASE_MS=800
# BROWSER_NAV_TIMEOUT_MS=30000  BROWSER_READY_TIMEOUT_MS=8000
